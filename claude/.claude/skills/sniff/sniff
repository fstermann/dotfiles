#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"

if [ -x "$ROOT/.venv/bin/sniff" ]; then
  exec "$ROOT/.venv/bin/sniff" "$@"
fi

if command -v uv >/dev/null 2>&1; then
  exec uv run --quiet --project "$ROOT" sniff "$@"
fi

if ! python3 -c 'import yaml' >/dev/null 2>&1; then
  echo "sniff: error: install uv or install this package's dependencies first" >&2
  exit 2
fi

export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m sniff_cli "$@"
